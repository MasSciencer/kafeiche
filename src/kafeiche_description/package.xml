<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kafeiche_description</name>
  <version>1.0.0</version>
  <description>
    <p>URDF Description package for kafeiche robot</p>
    <p>This package contains configuration data, 3D models, and launch files for kafeiche robot.</p>
  </description>

  <maintainer email="nono@gmail.com">kafeiche</maintainer>
  <author email="nono@gmail.com">kafeiche</author>
  <license>BSD</license>

  <!-- Build tool dependencies -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Build dependencies -->
  <build_depend>urdf</build_depend>
  <build_depend>tf</build_depend>
  <build_depend>xacro</build_depend>

  <!-- Runtime dependencies -->
  <exec_depend>urdf</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>xacro</exec_depend>

  <!-- Test dependencies -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <architecture_independent/>
  </export>
</package>
