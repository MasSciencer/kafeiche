<?xml version="1.0" encoding="utf-8"?>
<robot name="kafeiche" xmlns:xacro="http://www.ros.org/wiki/xacro">


  <xacro:include filename="$(find kafeiche_description)/urdf/kafeiche_control.xacro" />
  <xacro:property name="mesh_pkg" value="package://kafeiche_description/meshes/" />

  <!-- ────────────────────────────────────────────────
       Макросы
  ──────────────────────────────────────────────── -->

  <xacro:macro name="simple_inertial" params="mass ixx:=0.01 iyy:=0.01 izz:=0.01">
    <inertial>
      <mass value="${mass}" />
      <inertia ixx="${ixx}" ixy="0.0" ixz="0.0" iyy="${iyy}" iyz="0.0" izz="${izz}" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="mesh_link" params="name mesh mass origin_xyz origin_rpy ixx:=0.01 iyy:=0.01 izz:=0.01">
    <link name="${name}">
      <xacro:simple_inertial mass="${mass}" ixx="${ixx}" iyy="${iyy}" izz="${izz}" />
      <visual>
        <origin xyz="${origin_xyz}" rpy="${origin_rpy}" />
        <geometry>
          <mesh filename="${mesh}"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="${origin_xyz}" rpy="${origin_rpy}" />
        <geometry>
          <mesh filename="${mesh}"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <!-- Фиксированное соединение -->
  <xacro:macro name="fixed_joint" params="name parent child origin_xyz origin_rpy">
    <joint name="${name}" type="fixed">
      <parent link="${parent}" />
      <child  link="${child}"  />
      <origin xyz="${origin_xyz}" rpy="${origin_rpy}" />
    </joint>
  </xacro:macro>

  <!-- Вращающееся соединение для колёс -->
  <xacro:macro name="wheel_joint" params="name parent child origin_xyz origin_rpy axis_xyz">
    <joint name="${name}" type="continuous">
      <parent link="${parent}" />
      <child  link="${child}"  />
      <origin xyz="${origin_xyz}" rpy="${origin_rpy}" />
      <axis xyz="${axis_xyz}" />
    </joint>
  </xacro:macro>

  <!-- ────────────────────────────────────────────────
       Основные ссылки
  ──────────────────────────────────────────────── -->

  <!-- base_link — корневая система координат -->
  <link name="base_link" />

  <!-- Главный корпус -->
  <xacro:mesh_link name="kafeiche_base"
                   mesh="${mesh_pkg}base.stl"
                   mass="5.0"
                   origin_xyz="0 0 0" origin_rpy="0 0 0" />

  <xacro:fixed_joint name="kafeiche_base_to_base_link"
                     parent="base_link" child="kafeiche_base"
                     origin_xyz="0 0 0" origin_rpy="0 0 0" />

  <!-- Пассивное колесо -->
  <xacro:mesh_link name="passive_wheel"
                   mesh="${mesh_pkg}passive.stl"
                   mass="0.5"
                   origin_xyz="0 0 0" origin_rpy="0 0 0" />

  <xacro:fixed_joint name="passive_joint"
                    parent="kafeiche_base" child="passive_wheel"
                    origin_xyz="-0.266 -0.017 0.046" origin_rpy="0 0 0" />

  <!-- Правое колесо -->
  <xacro:mesh_link name="right_wheel"
                   mesh="${mesh_pkg}right.stl"
                   mass="1.0"
                   origin_xyz="0 0 0" origin_rpy="0 0 0" />

  <xacro:wheel_joint name="right_wheel_joint"
                     parent="kafeiche_base" child="right_wheel"
                     origin_xyz="0 -0.156 0.075" origin_rpy="0 0 0" 
                     axis_xyz="0 -1 0"/>

  <!-- Левое колесо -->
  <xacro:mesh_link name="left_wheel"
                   mesh="${mesh_pkg}left.stl"
                   mass="1.0"
                   origin_xyz="0 0 0" origin_rpy="0 0 0" />

  <xacro:wheel_joint name="left_wheel_joint"
                     parent="kafeiche_base" child="left_wheel"
                     origin_xyz="0 0.133 0.075" origin_rpy="0 0 0"
                     axis_xyz="0 -1 0" />

  <!-- Лидар -->
  <xacro:mesh_link name="laser"
                   mesh="${mesh_pkg}laser.stl"
                   mass="5.0"
                   origin_xyz="0 0 0" origin_rpy="0 0 0" />

  <xacro:fixed_joint name="laser_joint"
                     parent="kafeiche_base" child="laser"
                     origin_xyz="-0.257 0 0.278" origin_rpy="0 0.04 -3.1416" />

</robot>